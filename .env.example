# web_02 — variáveis de ambiente (exemplo). NÃO commitar .env real.
# Segredos via padrão _FILE (montados em /run/secrets em prod via cofre).
# IdP = Ory (migração Authentik → Ory): Hydra (OAuth2/OIDC, emite o JWT) + Kratos (identidade/login).

# --- OIDC (Ory Hydra) — o app é cliente OIDC do Hydra ---
# Issuer público do Hydra = raiz (discovery em /.well-known/openid-configuration).
# Prod: https://auth.cesasmaf.app.br · Dev (x99 via Tailscale): http://100.99.66.84:4444
OIDC_ISSUER=http://100.99.66.84:4444
# JWKS p/ validar o JWT (pode ser interno em prod; iss continua público).
# Default = ${OIDC_ISSUER}/.well-known/jwks.json
# OIDC_JWKS_URL=http://hydra:4444/.well-known/jwks.json
OIDC_CLIENT_ID=acdg-web
OIDC_CLIENT_SECRET_FILE=./.secrets/oidc_client_secret

# --- Ory Kratos — identidade/login (o app renderiza o self-service login flow) ---
# A Public API é consumida por DOIS clientes diferentes, e cada um precisa de um endereço:
#   PUBLIC  = o fetch deste servidor (ler o flow, whoami). Em prod é o nome de serviço da
#             app-net, que é `internal: true` — o container não alcança o IP público.
#   BROWSER = as URLs que devolvemos num redirect e o NAVEGADOR vai buscar. Em prod é o
#             gateway (https://id.cesasmaf.app.br); apontar para a interna trava o login
#             num host que só existe dentro do Docker (infra#14). Obrigatória em produção.
# Em dev, com uma instância só alcançável dos dois lados, as duas podem ter o mesmo valor.
KRATOS_PUBLIC_URL=http://100.99.66.84:4433
KRATOS_BROWSER_URL=http://100.99.66.84:4433
# Admin API (server-only; provisionamento). NUNCA exposta ao browser.
KRATOS_ADMIN_URL=http://100.99.66.84:4434

# Sessão (assinatura do cookie opaco)
SESSION_SECRET_FILE=./.secrets/session_secret

# Redis (Bun.redis) — store de sessão server-side (ADR-0005)
REDIS_URL=redis://localhost:6379

# Base pública (para montar redirect_uri do OIDC = ${PUBLIC_BASE_URL}/api/auth/callback)
PUBLIC_BASE_URL=http://localhost:3000

# Serviços de backend (server-only; o BFF injeta Bearer)
SOCIAL_CARE_URL=http://localhost:8080
PEOPLE_CONTEXT_URL=http://localhost:8081
ANALYSIS_BI_URL=http://localhost:8082
